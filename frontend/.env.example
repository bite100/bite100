# ============================================================
# 前端环境变量
# 使用：复制为 .env，本地开发一般无需修改，直接 npm run dev 即可
# ============================================================

# 网络：sepolia（测试网）| mainnet | polygon
VITE_NETWORK=sepolia

# P2P 连接（本地开发用下面默认值即可）
VITE_P2P_WS_URL=ws://localhost:8080/ws
VITE_P2P_WS_URLS=
VITE_P2P_API_URL=http://localhost:8080
VITE_NODE_API_URL=http://localhost:8080,http://localhost:8081

# WalletConnect（移动端必填：无则内置浏览器易打不开，填后扫码或弹窗内选 WalletConnect）
VITE_WC_PROJECT_ID=

# 第二十轮快线（LI.FI 聚合，做市商垫付通道）：均可选
# 无 key 时走官方免 key 通道（限流较紧）；主网上线前由 Ren 在 LI.FI Partner Portal 免费申请后填入
VITE_LIFI_API_KEY=
# 集成方标识（在 Partner Portal 登记后启用，用于费用分成统计；未登记前留空）
VITE_LIFI_INTEGRATOR=
